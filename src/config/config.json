{
  "site": {
    "title": "Brady Diesel Services",
    "base_url": "https://astroplate.netlify.app",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/Image.jpg",
    "logo": "/images/logolge2.jpg",
    "logo_darkmode": "/images/logolge2.png",
    "logo_width": "150",
    "logo_height": "80",
    "logo_text": "Brady Diesel Services"
  },
  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 2,
    "summary_length": 200,
    "blog_folder": "blog"
  },
  "announcement": {
    "enable": true,
    "content": "<span class='text-center block'> Need Roadside Assistance? <a class='underline' href='https://github.com/zeon-studio/astroplate' target='_blank' rel='noopener'>Request it here.</a></span>",
    "expire_days": 7
  },
  "params": {
    "contact_form_action": "#",
    "copyright": "Brady Diesel Services"
  },
  "navigation_button": {
    "enable": true,
    "label": "Visit Brady",
    "link": "https://www.bradygo.com"
  },
  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },
  "disqus": {
    "enable": true,
    "shortname": "themefisher-template",
    "settings": {}
  },
  "metadata": {
    "meta_author": "zeon.studio",
    "meta_image": "/images/og-image.png",
    "meta_description": "astro and tailwind boilerplate"
  },
  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  },
  "draft": false
}
